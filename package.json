{
  "name": "nh-terminal",
  "version": "1.0.0",
  "description": "NH Terminal - Advanced Trading Platform built with React",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB,MAIL -c blue,green,magenta \"npm:dev:api\" \"vite\" \"npm:dev:mail\"",
    "dev:api": "node --env-file-if-exists=.env.database.local --env-file-if-exists=.env.local server/index.js",
    "dev:mail": "mailpit --smtp 127.0.0.1:1025 --listen 127.0.0.1:8025",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "db:migrate": "node --env-file-if-exists=.env.database.local --env-file-if-exists=.env.local scripts/database.js migrate",
    "db:rollback": "node --env-file-if-exists=.env.database.local --env-file-if-exists=.env.local scripts/database.js rollback",
    "db:status": "node --env-file-if-exists=.env.database.local --env-file-if-exists=.env.local scripts/database.js status",
    "db:seed:local": "node --env-file-if-exists=.env.database.local --env-file-if-exists=.env.local scripts/seed-local-database.js",
    "db:backup:local": "node --env-file-if-exists=.env.database.local --env-file-if-exists=.env.local scripts/database-backup.js backup",
    "db:restore:rehearse": "node --env-file-if-exists=.env.database.local --env-file-if-exists=.env.local scripts/database-backup.js rehearse",
    "ai:train": "node --env-file-if-exists=.env.ai.local scripts/ai-signals.js train",
    "ai:decide": "node --env-file-if-exists=.env.ai.local scripts/ai-signals.js decide",
    "ai:watch": "node --env-file-if-exists=.env.ai.local scripts/ai-signals.js watch",
    "ai:status": "node scripts/ai-signals.js status",
    "db:reset:test": "node --env-file-if-exists=.env.test.local scripts/reset-test-database.js",
    "db:migrate:test": "node --env-file-if-exists=.env.test.local scripts/database.js migrate",
    "db:seed:test": "node --env-file-if-exists=.env.test.local scripts/seed-local-database.js",
    "check:types": "tsc --noEmit",
    "ci:verify": "npm run check:types && npm run lint && npm run format:check && npm test && npm run test:e2e && npm run build",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"{src,server,api,scripts,tests}/**/*.{js,jsx,ts,css,md,json}\" \"*.{js,json,md}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"{src,server,api,scripts,tests}/**/*.{js,jsx,ts,css,md,json}\" \"*.{js,json,md}\" \".github/**/*.yml\"",
    "pretest": "npm run db:reset:test && npm run db:migrate:test && npm run db:seed:test",
    "test": "node --env-file-if-exists=.env.test.local ./node_modules/vitest/vitest.mjs run",
    "test:coverage": "vitest --coverage",
    "pretest:e2e": "npm run db:reset:test && npm run db:migrate:test && npm run db:seed:test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tanstack/react-query": "^5.102.2",
    "axios": "^1.6.2",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "lucide-react": "^0.294.0",
    "nodemailer": "^10.2.1",
    "postgres": "^3.4.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.2",
    "zod": "^4.5.4",
    "zustand": "^4.4.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "tailwindcss": "^3.4.0",
    "terser": "^5.50.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.12"
  }
}
