# API Configuration. Keep third-party provider secrets on this backend.
VITE_API_URL=https://api.nhterminal.com/v1
VITE_WS_URL=wss://ws.nhterminal.com
VITE_API_TIMEOUT=30000

# App Configuration
VITE_APP_NAME=NH Terminal
VITE_APP_VERSION=1.0.0
VITE_ENV=development
VITE_LOG_LEVEL=debug
VITE_APP_ENV=development

# Infrastructure
VITE_CDN_URL=
VITE_ANALYTICS_URL=

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true
VITE_ENABLE_WEBSOCKET=true
VITE_MAINTENANCE_MODE=false
VITE_ENABLE_LIVE_MARKET=false
VITE_ENABLE_LIVE_COMMUNITY=false

# Third Party Services
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=
VITE_TURNSTILE_SITE_KEY=

# Authentication
VITE_TOKEN_STORAGE_KEY=authToken
# Rotate the browser session every 12 hours while the app remains open.
VITE_TOKEN_REFRESH_INTERVAL=43200000

# Server-only preview account. Do not prefix these with VITE_ or use them in production.
DEMO_ACCOUNT_EMAIL=admin@nhterminal.local
DEMO_ACCOUNT_PASSWORD=NHAdmin1234!

# Managed PostgreSQL (server only). Use a distinct database for each environment.
# The application remains on the JSON demo repository until the feature repositories
# are migrated; these settings power schema migrations and connection verification.
APP_ENV=development
DATABASE_URL=
DATABASE_SSL=require
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_SECONDS=10
# Local-only PostgreSQL backup tooling. Keep backup output inside the workspace.
POSTGRES_BIN=C:\Program Files\PostgreSQL\18\bin
LOCAL_BACKUP_DIRECTORY=.backups
RESTORE_REHEARSAL_DATABASE=nh_terminal_test
SESSION_COOKIE_SECURE=true
API_ALLOWED_ORIGIN=https://nhterminal.com
APP_ORIGIN=https://nhterminal.com
TURNSTILE_SECRET_KEY=
# Cloudflare Stream account settings. Never expose these as VITE_ variables.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_LIVE_INPUT_ID=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
EMAIL_FROM=NH Terminal <no-reply@nhterminal.local>

# Market Data
TWELVE_DATA_API_KEY=
VITE_PRICE_UPDATE_INTERVAL=1000
VITE_CHART_POINTS_LIMIT=500

# Provider selection is public configuration; provider API keys are NOT VITE_ variables.
VITE_MARKET_PROVIDER=twelve-data
VITE_CALENDAR_PROVIDER=trading-economics

# UI Configuration
VITE_THEME=dark
VITE_LOCALE=en-US
