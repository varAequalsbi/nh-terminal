# API Configuration
VITE_API_URL=https://api.nhterminal.com/v1
VITE_WS_URL=wss://ws.nhterminal.com
VITE_API_TIMEOUT=30000

# App Configuration
VITE_APP_NAME=NH Terminal
VITE_APP_VERSION=1.0.0
VITE_ENV=development
VITE_LOG_LEVEL=debug

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true
VITE_ENABLE_WEBSOCKET=true

# Third Party Services
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# Authentication
VITE_TOKEN_STORAGE_KEY=authToken
VITE_TOKEN_REFRESH_INTERVAL=600000

# Market Data
VITE_PRICE_UPDATE_INTERVAL=1000
VITE_CHART_POINTS_LIMIT=500

# UI Configuration
VITE_THEME=dark
VITE_LOCALE=en-US
